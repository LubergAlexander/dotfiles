font-family = "BerkeleyMono Nerd Font"
font-size = 17
font-thicken = false
adjust-cell-height = 4%

window-padding-x = 12
window-padding-y = 10

# Preserve native capabilities; install xterm-ghostty terminfo on remote hosts.
term = xterm-ghostty

theme = light:gruvbox-light,dark:gruvbox-dark
keybind = shift+enter=text:\x1b\r
