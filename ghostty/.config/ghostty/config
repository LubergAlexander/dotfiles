font-family = "BerkeleyMono Nerd Font"
font-size = 17
font-thicken = false
adjust-cell-height = 4%

window-padding-x = 8
window-padding-y = 10
window-padding-balance = true
# Keep status-bar backgrounds inside the grid, clear of macOS window corners.
window-padding-color = background

# Preserve native capabilities; install xterm-ghostty terminfo on remote hosts.
term = xterm-ghostty

theme = light:gruvbox-light,dark:gruvbox-dark
keybind = shift+enter=text:\x1b\r
