// Minimal Zed that mirrors the Neovim/Ghostty setup: vim mode, Gruvbox following
// macOS appearance, Berkeley Mono (Hack fallback), and chrome hidden until needed.
{
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  // Languages Zed doesn't bundle, matching the Neovim treesitter parsers
  "auto_install_extensions": {
    "lua": true,
    "toml": true,
    "dockerfile": true,
    "helm": true,
    "make": true,
    "terraform": true
  },

  // Editing model
  "vim_mode": true,
  "which_key": { "enabled": true },
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "cursor_blink": false,
  "tab_size": 4,
  "soft_wrap": "none",
  "show_whitespaces": "selection",
  // Neovim's ignorecase+smartcase: lowercase matches any case, a capital makes it exact.
  "use_smartcase_search": true,
  "vim": {
    "use_smartcase_find": true,
    // Yanks reach the macOS clipboard; deletes/changes stay in vim registers.
    "use_system_clipboard": "on_yank",
    "highlight_on_yank_duration": 150,
    // Absolute numbers in insert mode, relative elsewhere.
    "toggle_relative_line_numbers": true,
    "cursor_shape": { "normal": "block", "visual": "block", "replace": "underline", "insert": "bar" }
  },
  "inlay_hints": { "enabled": true, "edit_debounce_ms": 300 },

  // Appearance
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark"
  },
  "buffer_font_family": "BerkeleyMono Nerd Font",
  "buffer_font_fallbacks": ["Hack Nerd Font Mono"],
  "buffer_font_features": { "calt": true, "liga": true },
  "buffer_font_size": 17,
  // Ghostty's cell height: Berkeley Mono's 1.2 line metrics plus adjust-cell-height 4%.
  "buffer_line_height": { "custom": 1.25 },
  "ui_font_size": 16,
  "terminal": {
    "font_family": "BerkeleyMono Nerd Font",
    "font_fallbacks": ["Hack Nerd Font Mono"],
    "font_size": 17,
    "button": false,
    "toolbar": { "breadcrumbs": false }
  },

  // Minimal chrome: no minimap/scrollbar/breadcrumbs, panels behind keys
  "minimap": { "show": "never" },
  "scrollbar": { "show": "never" },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "tab_bar": { "show_nav_history_buttons": false, "show_tab_bar_buttons": false },
  "tabs": { "file_icons": true, "git_status": true, "show_diagnostics": "errors" },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_menus": false
  },
  "gutter": { "folds": false, "runnables": false, "breakpoints": true },
  "indent_guides": { "enabled": true, "coloring": "fixed" },
  // Blame appears only after the cursor rests on a line.
  "git": { "inline_blame": { "enabled": true, "delay_ms": 600, "show_commit_summary": true } },
  "centered_layout": { "left_padding": 0.2, "right_padding": 0.2 },
  // Replaces Zed's defaults (VCS dirs, OS junk) plus caches and dependency trees.
  "file_scan_exclusions": [
    "**/.git", "**/.svn", "**/.hg", "**/.jj", "**/.sl", "**/.repo", "**/CVS",
    "**/.DS_Store", "**/Thumbs.db", "**/.classpath", "**/.settings",
    "**/.venv", "**/__pycache__", "**/.mypy_cache", "**/.pytest_cache", "**/.ruff_cache",
    "**/node_modules", "**/vendor", "**/.terraform"
  ],
  "project_panel": { "button": false, "dock": "left", "hide_gitignore": false },
  "outline_panel": { "button": false },
  "collaboration_panel": { "button": false },
  "git_panel": { "button": false },
  "debugger": { "button": false },
  "diagnostics": { "button": false },
  "search": { "button": false },

  // AI: agents via ACP, no inline edit predictions (matches Neovim)
  "agent_servers": {
    "claude-acp": { "type": "registry" },
    "cursor": { "type": "registry" },
    // oh-my-pi over ACP; reuses provider credentials under ~/.omp
    "omp": { "default_config_options": {
                 "model": "anthropic/claude-opus-5-5"
             },
             "type": "custom", "command": "omp", "args": ["acp"] }
  },
  "edit_predictions": { "provider": "none" },

  // Formatting mirrors conform.nvim: format on save, trim whitespace
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "languages": {
    "Go": {
      "code_actions_on_format": { "source.organizeImports": true }
    },
    "Python": {
      "language_servers": ["basedpyright", "ruff", "!pyright", "!pylsp"],
      "formatter": { "language_server": { "name": "ruff" } },
      "code_actions_on_format": { "source.organizeImports.ruff": true }
    },
    "Shell Script": { "tab_size": 4 },
    "YAML": { "tab_size": 2 },
    "JSON": { "tab_size": 2 },
    "Markdown": { "soft_wrap": "editor_width" }
  },
  "lsp": {
    "lua-language-server": {
      "settings": { "Lua": { "diagnostics": { "globals": ["vim"] } } }
    },
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "staticcheck": true,
        "analyses": { "unusedparams": true, "shadow": true }
      }
    }
  }
}
