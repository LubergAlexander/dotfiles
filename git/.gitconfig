# Identity and credential helpers live in ~/.gitconfig.local (machine-specific,
# not in the repo — gh's credential helper needs an absolute path per machine)
[include]
	path = ~/.gitconfig.local

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[merge]
    conflictstyle = zdiff3
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
