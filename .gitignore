*.bak
.claude/

# OMP memory stores, including repository-local agent directories.
**/.omp/**/memories/
**/.config/omp/**/memories/

# OMP runtime data and credentials must never be committed.
omp/.omp/**
!omp/.omp/agent/
!omp/.omp/agent/config.yml
!omp/.omp/agent/lsp.yml
omp/.config/omp/**
!omp/.config/omp/agent/
!omp/.config/omp/agent/config.yml
!omp/.config/omp/agent/lsp.yml
